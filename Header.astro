---
import site from '../data/site.json';
import fs from 'node:fs';
const hasLogo = fs.existsSync('public/images/logo.png');
const path = Astro.url.pathname;
const nav = [
  { href: '/iv-therapy/', label: 'IV Therapy' },
  { href: '/weight-loss/', label: 'Weight Loss' },
  { href: '/injections/', label: 'Injections' },
  { href: '/membership/', label: 'Membership' },
  { href: '/about/', label: 'About' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/contact/', label: 'Contact' },
];
---
<div class="topbar">
  <div class="container topbar-inner">
    <span>{site.address.street}, {site.address.city}, {site.address.state} {site.address.zip}</span>
    <a href={site.phoneHref}>Call or text {site.phone}</a>
  </div>
</div>
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="iThrive Infusion & Wellness, home">
      {hasLogo
        ? <img class="logo" src="/images/logo.png" alt="" width="60" height="55" />
        : <><span class="mark" aria-hidden="true">i</span><span class="word">iThrive<small>Infusion &amp; Wellness</small></span></>}
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="call" href={site.phoneHref}><span class="visually-hidden">Call </span>{site.phone}</a>
      <a class="btn sm" href={site.bookingUrl} rel="noopener">Book now</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="mobile-nav">
        <span class="visually-hidden">Menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href={site.portalUrl} rel="noopener">Patient portal</a></li>
      <li><a href={site.phoneHref}>Call or text {site.phone}</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector('.menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (nav) nav.hidden = open;
  });
</script>

<style>
  .topbar { background: var(--green-500); color: var(--on-green); font-size: 0.9rem; font-weight: 600; }
  .topbar-inner { display: flex; justify-content: space-between; gap: 16px; padding-top: 8px; padding-bottom: 8px; }
  .topbar a { color: var(--on-green); text-decoration: none; white-space: nowrap; }
  @media (max-width: 640px) { .topbar-inner span { display: none; } .topbar-inner { justify-content: center; } }
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.96); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; height: 76px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .logo { height: 56px; width: auto; }
  .mark { width: 40px; height: 40px; border-radius: 50% 50% 50% 8px; background: var(--green-500); color: var(--green-900); display: grid; place-items: center; font-weight: 800; font-size: 1.3rem; transform: rotate(-45deg); }
  .word { font-weight: 800; font-size: 1.3rem; line-height: 1; display: flex; flex-direction: column; }
  .word small { font-weight: 600; font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 4px; }
  .nav ul { display: flex; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .nav a { white-space: nowrap; display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--ink); font-weight: 550; font-size: 0.97rem; }
  .nav a:hover, .nav a[aria-current] { background: var(--green-500); color: var(--on-green); }
  .actions { display: flex; align-items: center; gap: 14px; }
  .call { display: none; }
  .menu-btn { display: none; background: none; border: 1px solid var(--line); border-radius: 8px; padding: 8px; color: var(--ink); cursor: pointer; }
  .mobile-nav { border-top: 1px solid var(--line); background: var(--white); }
  .mobile-nav ul { list-style: none; margin: 0; padding: 8px 20px 16px; }
  .mobile-nav a { display: block; padding: 12px 0; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); font-weight: 600; }
  @media (max-width: 1180px) { .nav { display: none; } .menu-btn { display: block; } }
  @media (max-width: 560px) { .call { display: none; } .bar { height: 68px; } }
</style>
