---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props { title: string; description: string; schema?: object[] }
const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: site.name,
  url: site.url,
  telephone: '+1-505-926-2999',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: ['Albuquerque', 'Rio Rancho', 'Corrales'],
  openingHoursSpecification: site.hours.filter((h) => h.open).map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${h.day}`,
    opens: h.open,
    closes: h.close,
  })),
  founder: { '@type': 'Person', name: 'Ruth Nyang', jobTitle: 'Family Nurse Practitioner', honorificSuffix: 'MSN, FNP-C' },
  sameAs: Object.values(site.social).filter(Boolean),
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta name="theme-color" content="#2e5e2b" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify(business)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
