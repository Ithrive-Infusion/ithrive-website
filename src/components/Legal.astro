---
import Base from '../layouts/Base.astro';
interface Props { title: string; heading: string; description: string }
const { title, heading, description } = Astro.props;
---
<Base title={title} description={description}>
  <section class="page-hero"><div class="container" style="max-width:820px"><h1>{heading}</h1><p class="muted">Last updated: {new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p></div></section>
  <section class="section tight"><div class="container prose" style="max-width:820px"><slot /></div></section>
</Base>
<style>
  .prose :global(h2) { font-size: 1.35rem; margin-top: 1.8em; }
  .prose :global(p), .prose :global(li) { color: var(--muted); }
</style>
