---
// Chat bubble shown on every page. Talks to /api/chat (Claude) and /api/callback.
import site from '../data/site.json';
---
<div
  id="ic-chat"
  data-book={site.bookingUrl}
  data-tel={site.phoneHref}
  data-sms={site.smsHref}
  data-phone={site.phone}
>
  <button class="ic-launch" type="button" aria-expanded="false" aria-controls="ic-panel">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-4.5 3.6A.6.6 0 0 1 3.5 21V18H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3 6.5a1.5 1.5 0 1 0 0 .01Zm5 0a1.5 1.5 0 1 0 0 .01Zm5 0a1.5 1.5 0 1 0 0 .01Z"/></svg>
    <span>Questions? Chat with us</span>
  </button>

  <section id="ic-panel" class="ic-panel" role="dialog" aria-modal="false" aria-labelledby="ic-title" hidden>
    <div class="ic-head">
      <div>
        <p id="ic-title" class="ic-title">iThrive assistant</p>
        <p class="ic-sub">AI assistant · not medical advice</p>
      </div>
      <button class="ic-close" type="button" aria-label="Close chat">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4z"/></svg>
      </button>
    </div>

    <div class="ic-body">
      <div class="ic-log" role="log" aria-live="polite" aria-relevant="additions"></div>

      <form class="ic-callback" hidden novalidate>
        <p class="ic-cb-title">Request a call-back</p>
        <p class="ic-note">We only use this to call you back. Please don't include health details.</p>
        <label>Your name<input name="name" autocomplete="name" maxlength="80" required /></label>
        <label>Phone number<input name="phone" type="tel" autocomplete="tel" inputmode="tel" required /></label>
        <label>Best time to call
          <select name="time"><option>Any time</option><option>Morning</option><option>Afternoon</option><option>Evening</option></select>
        </label>
        <label>Topic
          <select name="topic">
            <option>Booking a visit</option><option>IV therapy</option><option>Weight loss</option><option>Injections</option>
            <option>Membership</option><option>Hormone therapy waitlist</option><option>Something else</option>
          </select>
        </label>
        <label class="ic-hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
        <p class="ic-error" role="alert"></p>
        <div class="ic-cb-actions">
          <button class="btn sm" type="submit">Send request</button>
          <button class="btn sm outline ic-cb-cancel" type="button">Back to chat</button>
        </div>
      </form>
    </div>

    <div class="ic-quick" aria-label="Quick actions">
      <a class="ic-chip" href={site.bookingUrl} rel="noopener">Book online</a>
      <a class="ic-chip" href={site.phoneHref}>Call</a>
      <a class="ic-chip" href={site.smsHref}>Text</a>
      <button class="ic-chip" type="button" data-act="callback">Call me back</button>
    </div>

    <form class="ic-input">
      <label class="visually-hidden" for="ic-text">Type your question</label>
      <textarea id="ic-text" rows="1" maxlength="600" placeholder="Ask about services, prices, hours…"></textarea>
      <button class="ic-send" type="submit" aria-label="Send">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12 2-12 2z"/></svg>
      </button>
    </form>
  </section>
</div>

<script>
  const root = document.getElementById('ic-chat') as HTMLElement;
  const d = root.dataset;
  const launch = root.querySelector('.ic-launch') as HTMLButtonElement;
  const panel = root.querySelector('.ic-panel') as HTMLElement;
  const log = root.querySelector('.ic-log') as HTMLElement;
  const input = root.querySelector('#ic-text') as HTMLTextAreaElement;
  const inputForm = root.querySelector('.ic-input') as HTMLFormElement;
  const cb = root.querySelector('.ic-callback') as HTMLFormElement;
  const cbError = cb.querySelector('.ic-error') as HTMLElement;
  const KEY = 'ithrive-chat';

  type Msg = { role: 'user' | 'assistant'; content: string };
  let history: Msg[] = [];
  let busy = false;

  const store = {
    load(): Msg[] { try { return JSON.parse(sessionStorage.getItem(KEY) || '[]'); } catch { return []; } },
    save() { try { sessionStorage.setItem(KEY, JSON.stringify(history.slice(-30))); } catch {} },
  };

  const PAGES: Record<string, string> = {
    '/iv-therapy/': 'See the IV menu', '/weight-loss/': 'Weight loss details', '/injections/': 'See injections',
    '/membership/': 'See memberships', '/about/': 'About Ruth', '/faq/': 'Read the FAQ',
    '/contact/': 'Map and hours', '/hormone-therapy/': 'Join the waitlist',
  };

  function el(tag: string, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  }

  function actionButtons(tags: string[]) {
    const row = el('div', 'ic-actions');
    for (const t of tags) {
      let a: HTMLElement | null = null;
      if (t === 'BOOK') { a = el('a', 'btn sm', 'Book online'); (a as HTMLAnchorElement).href = d.book!; a.setAttribute('rel', 'noopener'); }
      else if (t === 'CALL') { a = el('a', 'btn sm outline', `Call ${d.phone}`); (a as HTMLAnchorElement).href = d.tel!; }
      else if (t === 'CALLBACK') { a = el('button', 'btn sm outline', 'Request a call-back'); a.setAttribute('type', 'button'); a.addEventListener('click', openCallback); }
      else if (t.startsWith('PAGE:')) { const p = t.slice(5); if (PAGES[p]) { a = el('a', 'btn sm outline', PAGES[p]); (a as HTMLAnchorElement).href = p; } }
      if (a) row.appendChild(a);
    }
    return row.children.length ? row : null;
  }

  function addBubble(role: 'user' | 'assistant' | 'system', raw: string) {
    const tags: string[] = [];
    const text = raw.replace(/\[(BOOK|CALL|CALLBACK|PAGE:\/[a-z-]*\/?)\]/g, (_, t) => { tags.push(t); return ''; }).trim();
    const wrap = el('div', `ic-msg ic-${role}`);
    const who = el('span', 'visually-hidden', role === 'user' ? 'You said: ' : 'Assistant: ');
    wrap.appendChild(who);
    for (const para of text.split(/\n{2,}/)) wrap.appendChild(el('p', '', para));
    log.appendChild(wrap);
    if (role === 'assistant' && tags.length) {
      const row = actionButtons([...new Set(tags)].slice(0, 2));
      if (row) log.appendChild(row);
    }
    log.scrollTop = log.scrollHeight;
  }

  function welcome() {
    addBubble('system', "Hi! I can answer questions about our services, prices, hours and booking.\n\nI'm an AI assistant, so I can't give medical advice. Please don't share personal health details here. In an emergency, call 911.");
    const chips = el('div', 'ic-suggest');
    for (const q of ['How much is an IV?', 'How does weight loss work?', 'What are your hours?', 'What does membership include?']) {
      const b = el('button', 'ic-chip', q); b.setAttribute('type', 'button');
      b.addEventListener('click', () => { chips.remove(); send(q); });
      chips.appendChild(b);
    }
    log.appendChild(chips);
  }

  function typing(on: boolean) {
    const t = log.querySelector('.ic-typing');
    if (on && !t) { const x = el('div', 'ic-msg ic-assistant ic-typing'); x.setAttribute('aria-label', 'Assistant is typing'); x.innerHTML = '<span></span><span></span><span></span>'; log.appendChild(x); log.scrollTop = log.scrollHeight; }
    if (!on && t) t.remove();
  }

  async function send(text: string) {
    text = text.trim();
    if (!text || busy) return;
    busy = true;
    log.querySelector('.ic-suggest')?.remove();
    history.push({ role: 'user', content: text });
    addBubble('user', text);
    store.save();
    typing(true);
    let reply = '';
    try {
      const res = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history }) });
      const data = await res.json().catch(() => ({}));
      reply = data.reply || '';
    } catch {}
    typing(false);
    if (reply) {
      addBubble('assistant', reply);
      history.push({ role: 'assistant', content: reply });
    } else {
      addBubble('assistant', `Sorry, the assistant isn't available right now. Please call or text us at ${d.phone}, or book online.\n[CALL]\n[BOOK]`);
      history.pop();
    }
    store.save();
    busy = false;
  }

  function openCallback() {
    cb.hidden = false;
    log.hidden = true;
    cbError.textContent = '';
    (cb.querySelector('input[name=name]') as HTMLInputElement).focus();
  }
  function closeCallback() { cb.hidden = true; log.hidden = false; input.focus(); }

  cb.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(cb);
    const name = String(f.get('name') || '').trim();
    const phone = String(f.get('phone') || '').replace(/\D/g, '');
    if (!name) { cbError.textContent = 'Please enter your name.'; return; }
    if (!(phone.length === 10 || (phone.length === 11 && phone.startsWith('1')))) { cbError.textContent = 'Please enter a 10-digit phone number.'; return; }
    cbError.textContent = 'Sending…';
    try {
      const res = await fetch('/api/callback', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(Object.fromEntries(f)) });
      if (!res.ok) throw new Error(String(res.status));
      cb.reset();
      closeCallback();
      addBubble('system', "Thanks! Your request was sent. The team will call you back during clinic hours (Thursday to Saturday).");
    } catch {
      cbError.textContent = `Sorry, that didn't go through. Please call or text ${d.phone}.`;
    }
  });
  cb.querySelector('.ic-cb-cancel')!.addEventListener('click', closeCallback);
  root.querySelector('[data-act=callback]')!.addEventListener('click', openCallback);

  function open() {
    panel.hidden = false;
    launch.setAttribute('aria-expanded', 'true');
    root.classList.add('ic-open');
    if (!log.children.length) {
      history = store.load();
      if (history.length) {
        addBubble('system', "I'm an AI assistant, so I can't give medical advice. In an emergency, call 911.");
        history.forEach((m) => addBubble(m.role, m.content));
      }
      else welcome();
    }
    input.focus();
  }
  function close() {
    panel.hidden = true;
    launch.setAttribute('aria-expanded', 'false');
    root.classList.remove('ic-open');
    launch.focus();
  }

  launch.addEventListener('click', () => (panel.hidden ? open() : close()));
  root.querySelector('.ic-close')!.addEventListener('click', close);
  panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  inputForm.addEventListener('submit', (e) => { e.preventDefault(); const t = input.value; input.value = ''; input.style.height = ''; send(t); });
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); inputForm.requestSubmit(); } });
  input.addEventListener('input', () => { input.style.height = ''; input.style.height = Math.min(input.scrollHeight, 120) + 'px'; });
</script>

<style is:global>
  #ic-chat { position: fixed; right: 20px; bottom: 20px; z-index: 60; font-size: 16px; }
  .ic-launch {
    display: flex; align-items: center; gap: 10px; border: 0; cursor: pointer;
    background: var(--green-500); color: var(--on-green); font: 700 1rem var(--font);
    padding: 14px 20px; border-radius: 999px; box-shadow: 0 10px 30px rgba(45, 40, 40, 0.22);
  }
  .ic-launch:hover { background: var(--gold-500); color: var(--charcoal); }
  .ic-launch:focus-visible, .ic-close:focus-visible, .ic-chip:focus-visible, .ic-send:focus-visible { outline: 3px solid var(--gold-500); outline-offset: 3px; }
  #ic-chat.ic-open .ic-launch { display: none; }
  .ic-panel {
    position: absolute; right: 0; bottom: 0; width: 380px; height: min(620px, calc(100vh - 40px));
    background: var(--white); border-radius: 18px; box-shadow: 0 18px 50px rgba(45, 40, 40, 0.25);
    display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line);
  }
  .ic-panel[hidden] { display: none; }
  .ic-head { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; background: var(--charcoal); color: var(--white); }
  .ic-title { margin: 0; font: 700 1.05rem var(--font-head); color: var(--white); }
  .ic-sub { margin: 0; font-size: 0.82rem; color: #d9d6d6; }
  .ic-close { background: transparent; border: 0; color: var(--white); cursor: pointer; padding: 6px; border-radius: 8px; display: grid; }
  .ic-body { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--cream); }
  .ic-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .ic-log[hidden] { display: none; }
  .ic-msg { max-width: 88%; padding: 10px 14px; border-radius: 14px; line-height: 1.5; font-size: 0.97rem; }
  .ic-msg p { margin: 0; }
  .ic-msg p + p { margin-top: 0.6em; }
  .ic-assistant, .ic-system { background: var(--white); color: var(--ink); border: 1px solid var(--line); border-bottom-left-radius: 4px; align-self: flex-start; }
  .ic-system { background: var(--green-100); border-color: #d6e9c2; }
  .ic-user { background: var(--green-800); color: var(--white); border-bottom-right-radius: 4px; align-self: flex-end; }
  .ic-actions, .ic-suggest { display: flex; flex-wrap: wrap; gap: 8px; align-self: flex-start; }
  .ic-actions .btn { padding: 8px 14px; font-size: 0.9rem; }
  .ic-chip {
    display: inline-block; border: 1px solid var(--green-500); background: var(--white); color: var(--charcoal);
    border-radius: 999px; padding: 6px 12px; font: 600 0.88rem var(--font); cursor: pointer; text-decoration: none; line-height: 1.3;
  }
  .ic-chip:hover { background: var(--green-500); color: var(--on-green); }
  .ic-typing { display: flex; gap: 4px; padding: 14px; }
  .ic-typing span { width: 7px; height: 7px; border-radius: 50%; background: #9aa09a; animation: ic-dot 1s infinite ease-in-out; }
  .ic-typing span:nth-child(2) { animation-delay: 0.15s; }
  .ic-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes ic-dot { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ic-typing span { animation: none; opacity: 0.7; } }
  .ic-quick { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 12px 0; background: var(--white); border-top: 1px solid var(--line); }
  .ic-input { display: flex; gap: 8px; align-items: flex-end; padding: 10px 12px 12px; background: var(--white); }
  .ic-input textarea {
    flex: 1; resize: none; border: 1px solid #c9ccc6; border-radius: 12px; padding: 10px 12px;
    font: 1rem/1.4 var(--font); color: var(--ink); max-height: 120px;
  }
  .ic-input textarea:focus { outline: 2px solid var(--green-800); outline-offset: 1px; border-color: var(--green-800); }
  .ic-send { border: 0; background: var(--green-500); color: var(--on-green); width: 44px; height: 44px; border-radius: 12px; cursor: pointer; display: grid; place-items: center; flex: none; }
  .ic-send:hover { background: var(--gold-500); color: var(--charcoal); }
  .ic-callback { padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
  .ic-callback[hidden] { display: none; }
  .ic-cb-title { margin: 0; font: 700 1.1rem var(--font-head); color: var(--ink); }
  .ic-note { margin: 0; font-size: 0.88rem; }
  .ic-callback label { display: flex; flex-direction: column; gap: 4px; font-weight: 600; font-size: 0.92rem; color: var(--ink); }
  .ic-callback input, .ic-callback select { font: 1rem var(--font); padding: 9px 10px; border: 1px solid #c9ccc6; border-radius: 10px; background: var(--white); color: var(--ink); }
  .ic-callback input:focus, .ic-callback select:focus { outline: 2px solid var(--green-800); outline-offset: 1px; }
  .ic-hp { position: absolute !important; left: -9999px; }
  .ic-error { margin: 0; min-height: 1.2em; font-size: 0.9rem; color: #9b1c1c; }
  .ic-cb-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  @media (max-width: 520px) {
    #ic-chat { right: 12px; bottom: 12px; }
    .ic-launch span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ic-launch { padding: 16px; }
    #ic-chat.ic-open { left: 0; right: 0; bottom: 0; }
    .ic-panel { position: fixed; inset: auto 0 0 0; width: 100%; height: 100dvh; border-radius: 0; border: 0; }
  }
  @media print { #ic-chat { display: none; } }
</style>
