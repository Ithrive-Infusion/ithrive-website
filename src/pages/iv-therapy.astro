---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import site from '../data/site.json';
import svc from '../data/services.json';
import { faqSchema } from '../lib';

const ivs = svc.ivs.filter((i) => !i.review);
const specialty = svc.specialty.filter((i) => !i.review);
const from = Math.min(...ivs.map((i) => i.price));

const chooser = [
  { want: 'Rehydrate after a late night, travel or a long week', pick: 'iRecover', id: 'irecover' },
  { want: 'A classic all-around vitamin blend', pick: 'iEmpower', id: 'iempower' },
  { want: 'A beauty-focused blend', pick: 'iGlow', id: 'iglow' },
  { want: 'Support alongside a weight loss program', pick: 'iTrim / iEnergize', id: 'itrim' },
  { want: 'A bit of everything', pick: 'iThrive', id: 'ithrive' },
];

const faqs = [
  { q: 'Who should not get an IV infusion?', a: 'IV therapy is not right for everyone. Some heart, kidney and other medical conditions, pregnancy and certain medications can make an infusion unsafe. That is why we review your health history and vital signs first, and we may recommend you check with your primary care provider.' },
  { q: 'Can I add extras to my drip?', a: 'Yes. Your provider can add vitamins, minerals or, when appropriate, medication for nausea, heartburn or discomfort. Medications are added only after your provider reviews your history.' },
  { q: 'How often can I get an infusion?', a: 'It depends on the infusion and your health. Your provider will recommend a schedule that fits you.' },
  { q: 'Is there a way to save?', a: 'Yes. Our <a href="/membership/">IV Wellness membership</a> includes 2 infusions a month plus 20% off additional IVs and add-ons.' },
];
---
<Base
  title="IV Therapy Menu and Prices | iThrive, Albuquerque"
  description={`IV vitamin therapy in northwest Albuquerque from $${from}. See every drip, its ingredients and price. Licensed nurses, health review before treatment.`}
  schema={[faqSchema(faqs)]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">IV therapy</span>
      <h1>IV vitamin therapy in Albuquerque: menu and prices</h1>
      <p class="lead">Every infusion is given by a licensed nurse after a health review with our provider. Prices are per infusion.</p>
      <div class="btn-row">
        <a class="btn" href={site.bookingUrl} rel="noopener">Book an IV visit</a>
        <a class="btn outline" href="#chooser">Help me choose</a>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <p class="notice"><strong>Before your first infusion:</strong> we review your health history, current medications and vital signs. IV therapy is not right for everyone, and our infusions are not intended to diagnose, treat, cure or prevent any disease.</p>
    </div>
  </section>

  <section class="section" style="padding-top:24px">
    <div class="container">
      <div class="section-head"><h2>Signature drips</h2></div>
      <div class="grid grid-3">
        {ivs.map((d) => (
          <article class="card" id={d.id}>
            <div class="row"><h3>{d.name}</h3><span class="price">${d.price}</span></div>
            <span class="tag">{d.tagline}</span>
            <p class="muted grow">{d.summary}</p>
            <ul class="chips" aria-label="Ingredients">{d.ingredients.map((x) => <li>{x}</li>)}</ul>
            {d.addOnsNote && <p class="small muted">{d.addOnsNote}</p>}
            <a class="btn sm" href={site.bookingUrl} rel="noopener">Book {d.name}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="chooser">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Not sure where to start?</span>
        <h2>Which drip fits you</h2>
        <p class="muted">A starting point only. Your provider will confirm what is right for you at your visit.</p>
      </div>
      <table class="table chooser">
        <thead><tr><th>If you want…</th><th>Start with</th></tr></thead>
        <tbody>
          {chooser.map((c) => <tr><td>{c.want}</td><td><a href={`#${c.id}`}>{c.pick}</a></td></tr>)}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Specialty infusions</span>
        <h2>Specialty IVs</h2>
        <p class="muted">These require a provider consultation first. Specialty IVs are not included in membership infusions.</p>
      </div>

      <div class="grid grid-2">
        <article class="card" id="nad">
          <h3>{svc.nad.name}</h3>
          <p class="muted">{svc.nad.summary}</p>
          <table class="table">
            <thead><tr><th>Dose</th><th>Time</th><th>Price</th></tr></thead>
            <tbody>{svc.nad.doses.map((d) => <tr><td>{d.label}</td><td>{d.time}</td><td class="num">${d.price}</td></tr>)}</tbody>
          </table>
          <a class="btn sm" href={site.bookingUrl} rel="noopener">Book an NAD+ consultation</a>
        </article>

        <article class="card" id="vitamin-c">
          <h3>{svc.vitaminC.name}</h3>
          <p class="muted">{svc.vitaminC.summary}</p>
          <table class="table">
            <thead><tr><th>Dose</th><th>Price</th></tr></thead>
            <tbody>{svc.vitaminC.doses.map((d) => <tr><td>{d.label}</td><td class="num">${d.price}</td></tr>)}</tbody>
          </table>
          <a class="btn sm" href={site.bookingUrl} rel="noopener">Request a consultation</a>
        </article>
      </div>

      <div class="grid grid-2" style="margin-top:24px">
        {specialty.map((d) => (
          <article class="card" id={d.id}>
            <div class="row"><h3>{d.name}</h3><span class="price">${d.price}</span></div>
            <p class="muted grow">{d.summary}</p>
            <ul class="chips" aria-label="Ingredients">{d.ingredients.map((x) => <li>{x}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream" id="ingredients">
    <div class="container">
      <div class="section-head">
        <h2>What is in an IV bag?</h2>
        <p class="muted">Every infusion starts with a sterile IV fluid, either normal saline or lactated Ringer's, which delivers fluids directly into the bloodstream. Vitamins and minerals are then added for your chosen blend.</p>
      </div>
      <dl class="glossary">
        <div><dt>B-Complex</dt><dd>A group of water-soluble B vitamins (B1, B2, B3, B5, B6) the body uses in energy metabolism.</dd></div>
        <div><dt>Vitamin B12</dt><dd>A B vitamin involved in nerve function and red blood cell production.</dd></div>
        <div><dt>Vitamin C</dt><dd>An antioxidant vitamin the body uses to make collagen.</dd></div>
        <div><dt>Magnesium</dt><dd>A mineral involved in muscle and nerve function.</dd></div>
        <div><dt>Zinc</dt><dd>A trace mineral involved in immune function.</dd></div>
        <div><dt>Biotin</dt><dd>A B vitamin (B7) involved in metabolizing fats and carbohydrates.</dd></div>
        <div><dt>Glutathione</dt><dd>An antioxidant made of three amino acids, produced naturally by the body.</dd></div>
        <div><dt>Alpha lipoic acid</dt><dd>An antioxidant compound produced naturally in small amounts by the body.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>IV therapy questions</h2></div>
      <Faq items={faqs} />
    </div>
  </section>

  <section class="section bg-mint">
    <div class="container center" style="max-width:720px">
      <h2>Ready to book your drip?</h2>
      <p class="lead center">Or save with 2 infusions a month on our membership.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn" href={site.bookingUrl} rel="noopener">Book an IV visit</a>
        <a class="btn outline" href="/membership/">See membership</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .row h3 { margin: 0; }
  .row .price { font-size: 1.25rem; }
  .card .table { margin: 6px 0 10px; }
  .card .btn { align-self: flex-start; margin-top: 6px; }
  .chooser { background: var(--white); border-radius: 12px; overflow: hidden; max-width: 820px; }
  .glossary { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 16px 40px; margin: 0; }
  .glossary dt { font-weight: 700; }
  .glossary dd { margin: 2px 0 0; color: var(--muted); }
  @media (max-width: 640px) { .glossary { grid-template-columns: 1fr; } }
</style>
