---
import Base from '../layouts/Base.astro';
import Hours from '../components/Hours.astro';
import site from '../data/site.json';
---
<Base
  title="Contact iThrive Infusion & Wellness | NW Albuquerque"
  description="Contact iThrive Infusion & Wellness at 4611 Greene Ave NW, Suite 311, Albuquerque. Call or text (505) 926-2999 or book online."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Contact iThrive Infusion &amp; Wellness in northwest Albuquerque</h1>
      <div class="btn-row">
        <a class="btn" href={site.phoneHref}>Call {site.phone}</a>
        <a class="btn outline" href={site.smsHref}>Text us</a>
        <a class="btn outline" href={site.bookingUrl} rel="noopener">Book online</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div>
        <h2 class="h3">Address</h2>
        <address>{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</address>
        <p><a href={site.mapsUrl} rel="noopener">Get directions</a></p>
        <p class="muted">Easy to reach from Rio Rancho and Corrales.</p>
        <h2 class="h3" style="margin-top:32px">Hours</h2>
        <Hours />
        <p class="notice small" style="margin-top:24px">Please do not send health details by text or email. For medical emergencies, call 911.</p>
        <p class="small"><a href={site.portalUrl} rel="noopener">Patient portal login</a></p>
      </div>
      <iframe class="map" title="Map to iThrive Infusion & Wellness" src={site.mapEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>
<style>
  .split { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; }
  .h3 { font-size: 1.3rem; }
  address { font-style: normal; margin-bottom: 1em; font-size: 1.1rem; }
  .map { width: 100%; min-height: 480px; border: 0; border-radius: 18px; box-shadow: var(--shadow); }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } .map { min-height: 320px; } }
</style>
