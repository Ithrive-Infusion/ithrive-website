---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import svc from '../data/services.json';
import { money } from '../lib';
const items = svc.injections.filter((i) => !i.review);
---
<Base
  title="Vitamin and B12 Injections in Albuquerque | iThrive"
  description="Vitamin B12, glutathione, lipotropic and NAD+ injections at iThrive in northwest Albuquerque. Prescribed after a visit with our nurse practitioner."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Injections</span>
      <h1>Vitamin and wellness injections in Albuquerque</h1>
      <p class="lead">Take-home vials are prescribed after an in-person or virtual visit with our provider and last about 2 to 3 months. Some injections are also available in clinic.</p>
      <div class="btn-row"><a class="btn" href={site.bookingUrl} rel="noopener">Book an injection visit</a></div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:860px">
      <table class="table">
        <thead><tr><th>Injection</th><th>Format</th><th>Price</th></tr></thead>
        <tbody>
          {items.map((i) => <tr><td><strong>{i.name}</strong></td><td class="muted">{i.detail}</td><td class="num">{money(i.price)}</td></tr>)}
        </tbody>
      </table>
      <p class="notice" style="margin-top:28px">Injections are prescribed only when our provider decides they are appropriate for you. They are not intended to diagnose, treat, cure or prevent any disease, and lipotropic injections are not a substitute for a weight loss program.</p>
    </div>
  </section>

  <section class="section bg-mint">
    <div class="container center" style="max-width:720px">
      <h2>Not sure which is right for you?</h2>
      <p class="lead center">Book a visit and our provider will go over your options.</p>
      <a class="btn" href={site.bookingUrl} rel="noopener">Book a visit</a>
    </div>
  </section>
</Base>
